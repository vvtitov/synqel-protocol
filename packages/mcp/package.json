{
  "name": "@synqel/mcp",
  "version": "0.1.1",
  "description": "Model Context Protocol adapter for Synqel — expose registry snapshot and execute actions over MCP",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["dist"],
  "repository": {
    "type": "git",
    "url": "https://github.com/vvtitov/synqel-protocol.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://github.com/vvtitov/synqel-protocol/tree/main/packages/mcp#readme",
  "bugs": {
    "url": "https://github.com/vvtitov/synqel-protocol/issues"
  },
  "keywords": [
    "ai",
    "agents",
    "mcp",
    "model-context-protocol",
    "semantic",
    "synqel"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@synqel/sdk": "workspace:^"
  },
  "peerDependencies": {
    "zod": "^3.25"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vitest": "^3.2.4",
    "zod": "^3.25.0"
  },
  "scripts": {
    "build": "tsc",
    "pretest": "bun run --cwd ../sdk build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "start": "node dist/cli.js",
    "prepublishOnly": "bun run test && bun run build"
  },
  "publishConfig": {
    "access": "public"
  }
}
